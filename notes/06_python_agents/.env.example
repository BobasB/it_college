# Google AI API Key
# Отримайте ваш API ключ на https://aistudio.google.com/app/apikey
# Скопіюйте цей файл як .env та вставте ваш реальний ключ
# Додайте .env до .gitignore, щоб випадково не завантажити його в репозиторій
GOOGLE_API_KEY=your_api_key_here

# Токен Telegram-бота: створіть бота через @BotFather (команда /newbot) і вставте токен
TELEGRAM_TOKEN=your_telegram_bot_token_here
